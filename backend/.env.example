# Opsional: tanpa key ini fitur AI memakai generator berbasis database (tanpa Claude)
ANTHROPIC_API_KEY=isi-dengan-api-key-anda
CLAUDE_MODEL=claude-haiku-5-5
PORT=3000

# --- Database ---
# Lokal (default): file backend/data/calmates.db. Bisa diganti:
# DB_PATH=/path/ke/calmates.db
# Online: Turso. Kalau diisi, backend memakai Turso (juga untuk `npm run seed`).
# TURSO_DATABASE_URL=libsql://calmates-namaanda.turso.io
# TURSO_AUTH_TOKEN=token-dari-turso

# --- Foto ---
# Lokal (default): folder backend/data/uploads
# UPLOADS_DIR=/path/ke/uploads
# Online: Vercel Blob (otomatis terisi setelah Blob store dihubungkan ke proyek Vercel)
# BLOB_READ_WRITE_TOKEN=

# Domain web yang boleh memanggil backend (default: semua)
# ALLOWED_ORIGIN=https://calmates.vercel.app
# Token dasbor moderator (/admin). Kosong = token acak tiap start.
ADMIN_TOKEN=ganti-dengan-token-rahasia
# Batas percobaan masuk per IP per 15 menit
# LOGIN_LIMIT=10
# Isi 1 bila di belakang proxy selain Vercel (di Vercel otomatis)
# TRUST_PROXY=1
